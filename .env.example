# Copy this file to .env and fill in the values. Never commit .env.
PORT=3000

# ai& Inference (OpenAI-compatible). Get these from the sponsor setup guide.
# Used by the race engineer. Restart the server after changing these.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional Neo4j Aura Free memory. Credentials stay on the server.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
